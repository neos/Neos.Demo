prototype(Neos.Demo:Presentation.Columns.One) < prototype(Neos.Demo:Presentation.Columns) {
    // This is used for the living styleguide (Monocle)
    // Read more about this in the README.md
    @styleguide.props.content = Neos.Demo:Presentation.Alert {
        content = 'First column'
    }

    content = null
    columns = 1
    class = 'neos-contentcollection'

    @if.hasContent = true
}
